# --- Storage (Upstash Redis, added via Vercel Marketplace > Upstash integration) ---
# Vercel's Upstash integration injects these automatically once connected to your project.
# Only set manually if you're running `vercel dev` locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth for the scan endpoint ---
# Any value you make up. Vercel automatically sends this as `Authorization: Bearer <value>`
# to your own native Cron Jobs, so native cron "just works" once this is set. Also pass it
# as ?secret=<value> when triggering from GitHub Actions or any other external scheduler.
CRON_SECRET=change-me-to-something-random

# --- Notifications: Telegram (recommended — free, 2-minute setup) ---
# 1. Message @BotFather on Telegram, /newbot, copy the token it gives you.
# 2. Message your new bot anything, then visit
#    https://api.telegram.org/bot<token>/getUpdates and read your chat id from the JSON.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Notifications: Email via Resend (optional, alternative/addition to Telegram) ---
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# --- Search location (mirrors what we've been using all session: League City, TX 77573) ---
TESLA_ZIP=77573
TESLA_LAT=29.51
TESLA_LNG=-95.13
TESLA_REGION=TX
TESLA_RANGE=200

# --- Matching criteria (tune these to match what you actually want flagged) ---
MAX_PRICE=36000
MIN_YEAR=2022
REQUIRE_LONG_RANGE_AWD=true
